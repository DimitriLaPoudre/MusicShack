# Required variables must be provided.
# Optional variables use the default value if omitted.


# -- Admin -- #
## Optional (default: admin)
ADMIN_DEFAULT_USERNAME=admin

## Optional (default: changemenow)
ADMIN_DEFAULT_PASSWORD=changemenow


# -- Database -- #
## Required
DB_PATH=./data/app.db


# -- Session -- #
## Optional (default: user_token)
SESSION_COOKIE_NAME=user_token

## Optional (default: 168h)
SESSION_EXP=168h

## Optional (default: 720h)
SESSION_REMEMBER_EXP=720h


# -- HTTP -- #
## Optional (default: 8080)
PORT=8080

## Optional (default: false)
HTTPS=false


# -- Log -- #
## Optional (default: false)
LOG_PRETTY=false

## Optional (default: info)
LOG_LEVEL=info


# -- Download -- #
## Required
DOWNLOAD_PATH=./downloads

## Optional (default: 3)
DOWNLOAD_CONCURRENT=3


# -- Plugin -- #
## Optional (default: 25)
PLUGIN_PAGINATION_LIMIT=25

## Optional (default: 0)
PLUGIN_PAGINATION_OFFSET=0

## Optional (default: 30m)
PLUGIN_CACHE_EXPIRATION=30m
